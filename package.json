{
  "name": "pez-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Containerised backlog runner: works a GitHub backlog unattended with Claude Code",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pez-bot": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "execa": "^10.0.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true
  }
}
