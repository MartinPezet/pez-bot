# pez-bot environment. Copy to .env and fill in. Every variable is listed; unset ones use the default shown.

# ---- Target -------------------------------------------------------------------
# Repo to work on (owner/name). Overrides the TARGET_REPO baked into the image.
TARGET_REPO=

# ---- GitHub auth: set the three App variables (recommended) OR GH_TOKEN ---------
# GitHub App installed on TARGET_REPO and DIGEST_REPO (same owner).
# Permissions: Contents, Issues, Pull requests, Discussions (read/write); Metadata (read).
GH_APP_ID=
GH_APP_INSTALLATION_ID=
# The App key, one of:
#  - Linux host: ./secrets/gh-app.pem owned by root with mode 0400 (the container refuses a key the agent
#    could read), and GH_APP_PRIVATE_KEY_FILE=/run/secrets/gh-app.pem
#  - Docker Desktop (Windows/macOS), where file permissions can't be set: the base64 of the .pem in
#    GH_APP_PRIVATE_KEY. PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("gh-app.pem"))
GH_APP_PRIVATE_KEY_FILE=
GH_APP_PRIVATE_KEY=
# Classic PAT (repo scope) for a bot user that collaborates on both repos.
GH_TOKEN=

# ---- Claude auth: exactly one ---------------------------------------------------
# From `claude setup-token` (Pro/Max plan).
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# ---- Digest (GitHub Discussions) ---------------------------------------------------
# Central repo for digests (Discussions enabled).
DIGEST_REPO=
# Category you create by hand, with the Announcement format.
DIGEST_CATEGORY=Daily Digest
# true: the bot creates the project's discussion itself (needs maintain rights).
DIGEST_AUTO_CREATE=false

# ---- Behaviour ---------------------------------------------------------------------
# 1: log every GitHub write and push instead of doing it. Claude still runs.
DRY_RUN=1
# Claude permission mode: default | acceptEdits | dontAsk | auto | bypassPermissions (firewall required).
PERMISSION_MODE=acceptEdits
# Claude Code release channel for updates: stable | latest.
CLAUDE_CHANNEL=stable
# Install and update the Superpowers plugin.
INSTALL_SUPERPOWERS=false
# Commit identity. For an App: your-app[bot] / <app-user-id>+your-app[bot]@users.noreply.github.com
BOT_GIT_NAME=pez-bot
BOT_GIT_EMAIL=pez-bot@users.noreply.github.com

# ---- Usage budget (shared with your own Claude use) ------------------------------------
# on: probe usage (claude /usage, then a 1-turn Haiku call) when no fresh reading exists.
USAGE_PROBE=on
# Max age of a usage reading, and minimum minutes between probes.
USAGE_MAX_AGE_MIN=30
# No fresh reading and the probe failed: allow (run, report in the digest) | block.
USAGE_UNKNOWN_POLICY=allow
# No non-urgent Claude job at or above this weekly utilisation (%).
WEEKLY_STOP_PCT=80
# Not even urgent work at or above this weekly utilisation (%).
WEEKLY_HARD_STOP_PCT=95
# No non-urgent job at or above this 5-hour utilisation (%).
FIVE_HOUR_START_MAX_PCT=60

# ---- Run windows (project time zone) -------------------------------------------------
# When Claude jobs may start. A window belongs to the day it starts (Fri 22:00-02:00 counts, Sun doesn't).
RUN_WINDOWS=mon-fri 09:00-12:00; mon-fri 22:00-02:00
# Minutes after a window closes before a still-running job is checkpointed.
WINDOW_GRACE_MIN=20
# Urgent issues may start outside windows.
URGENT_IGNORES_WINDOWS=true
# Process time zone (the project's `timezone` drives windows and the digest).
TZ=Europe/London

# ---- Housekeeping and health ---------------------------------------------------------
KEEP_BLOCKED_WORKTREES_DAYS=3
# Logs, transcripts and usage readings older than this are deleted.
RETENTION_DAYS=14
# Disk guard threshold (GB free on /data).
MIN_FREE_DISK_GB=10
# Dead man's switch: healthchecks.io / Uptime Kuma push URL (pinged after each job, /fail on errors).
HEALTH_PING_URL=
# Extra hosts the egress firewall allows, comma-separated.
EXTRA_ALLOWED_DOMAINS=
LOG_LEVEL=info

# ---- Set by compose.yaml for the test sidecars (don't set here) ---------------------------
# TEST_POSTGRES_URL=postgres://test:test@postgres-test:5432/app_test
# TEST_REDIS_URL=redis://redis-test:6379

# ---- Compose -------------------------------------------------------------------------
# Image to run, for example registry.example.com/pez-bot:latest
RUNNER_IMAGE=pez-bot:local
# Test sidecars: match production's major versions (and testServices in .backlog-runner.json).
POSTGRES_TEST_IMAGE=postgres:16-alpine
REDIS_TEST_IMAGE=redis:7-alpine
