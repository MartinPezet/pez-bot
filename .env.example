# pez-bot environment. Copy to .env and fill in. (Full reference arrives with the README in M8.)

# Target repo (owner/name). Overrides the TARGET_REPO baked into the image.
TARGET_REPO=

# GitHub auth: a GitHub App (recommended) installed on TARGET_REPO and DIGEST_REPO ...
GH_APP_ID=
GH_APP_INSTALLATION_ID=
# Put the key in ./secrets/ on the host, owned by root with mode 0400.
GH_APP_PRIVATE_KEY_FILE=/run/secrets/gh-app.pem
# ... or a classic PAT (repo scope) for a bot user. Set one mode, not both.
GH_TOKEN=

# Claude auth: exactly one. CLAUDE_CODE_OAUTH_TOKEN comes from `claude setup-token` (Pro plan).
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# Daily digest (GitHub Discussions)
DIGEST_REPO=
DIGEST_CATEGORY=Daily Digest

# Log intended GitHub writes instead of performing them.
DRY_RUN=1
